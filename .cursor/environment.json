{
  "name": "dobeu.net v3",
  "build": {
    "dockerfile": ".cursor/Dockerfile",
    "context": ".."
  },
  "user": "node",
  "install": "./scripts/cloud-agent-install.sh",
  "ports": [
    {
      "name": "Next.js dev server",
      "port": 3000
