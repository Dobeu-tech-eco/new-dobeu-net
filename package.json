  "description": "dobeu.net v3 \u2014 Next.js 15 marketing landing + minimal client portal for Dobeu Tech Solutions",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/upload-sourcemaps.mjs",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse:ci": "lhci autorun",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "build:strict": "node scripts/strict-build.mjs",
    "verify": "pnpm type-check && pnpm lint && pnpm test:ci && pnpm build:strict",
    "vcr:push-function": "pwsh -File scripts/push-vcr-function-image.ps1",
    "datadog:sourcemaps": "node scripts/upload-sourcemaps.mjs"
  },
