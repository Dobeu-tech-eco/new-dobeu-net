    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "mixpanel-browser": "^2.84.0",
    "motion": "^12.43.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.12",
