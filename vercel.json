{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],

  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "pnpm build",
      "devCommand": "pnpm dev",
      "installCommand": "pnpm install --frozen-lockfile"
    },
    "oci": {
      "root": "containers/function",
      "runtime": "container",
      "entrypoint": "Dockerfile",
      "routes": [
        {
          "src": "/oci",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/"
            }
          ]
        },
        {
          "src": "/oci/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    }
  },

  "rewrites": [
    {
      "source": "/oci",
      "destination": { "service": "oci" }
    },
    {
      "source": "/oci/(.*)",
      "destination": { "service": "oci" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],

  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },

  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|avif|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/oci/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
