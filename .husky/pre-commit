#!/usr/bin/env sh
# .husky/pre-commit — Dobeu.net
# Enforces agent context-loading and quality gates before every commit.
# Installed via: pnpm dlx husky install (run once after cloning)

# ── 1. Remind any agent or developer to have read the context files ──────────
echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  DOBEU.NET — PRE-COMMIT AGENT CONTEXT CHECK                 ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""
echo "  Before this commit lands, confirm you have:"
echo "  [1] Read CLAUDE.md (universal rulebook)"
echo "  [2] Read .agent/HANDOFF.md (last agent notes + open items)"
echo "  [3] Read STATUS.md (current phase + live blockers)"
echo "  [4] Synced with remote: git fetch --all"
echo ""

# ── 2. Block commits of debug logs left in source ────────────────────────────
echo "Scanning for debug console.log statements..."
if grep -r 'console\.log("\[v0\]' --include="*.ts" --include="*.tsx" . \
    --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=.git -l 2>/dev/null | grep -q .; then
  echo ""
  echo "ERROR: Found [v0] debug console.log statements in:"
  grep -r 'console\.log("\[v0\]' --include="*.ts" --include="*.tsx" . \
    --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=.git -l 2>/dev/null
  echo ""
  echo "Remove all console.log(\"[v0]...\") debug statements before committing."
  exit 1
fi
echo "  OK — no debug logs found."

# ── 3. Block commits of dangerouslySetInnerHTML without justification ─────────
echo "Scanning for dangerouslySetInnerHTML without justification comment..."
if grep -r "dangerouslySetInnerHTML" --include="*.tsx" . \
    --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=.git \
    -l 2>/dev/null | xargs -I{} grep -L "// SECURITY:" {} 2>/dev/null | grep -q .; then
  echo ""
  echo "WARNING: dangerouslySetInnerHTML found without a '// SECURITY:' justification comment."
  echo "Each use must have an inline comment explaining why HTML injection is necessary."
  echo "Add: // SECURITY: <reason> on the line above dangerouslySetInnerHTML"
  echo ""
  echo "Files affected:"
  grep -r "dangerouslySetInnerHTML" --include="*.tsx" . \
    --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=.git \
    -l 2>/dev/null | xargs -I{} grep -L "// SECURITY:" {} 2>/dev/null
  exit 1
fi
echo "  OK — dangerouslySetInnerHTML audit passed."

# ── 4. Block direct commits to main or dev ───────────────────────────────────
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "dev" ]; then
  echo ""
  echo "ERROR: Direct commits to '$BRANCH' are not allowed."
  echo ""
  echo "Branch discipline:"
  echo "  feature/* or fix/* → PR → dev → (QA gate) → PR → main"
  echo ""
  echo "Create a feature branch: git checkout -b feature/your-description"
  exit 1
fi
echo "  OK — branch is '$BRANCH' (not main or dev)."

# ── 5. Lint staged TypeScript/TSX files ──────────────────────────────────────
echo "Running ESLint on staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(ts|tsx)$")
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs pnpm exec next lint --fix --file 2>/dev/null
  if [ $? -ne 0 ]; then
    echo ""
    echo "ERROR: ESLint failed on staged files. Fix all lint errors before committing."
    exit 1
  fi
  echo "  OK — ESLint passed."
else
  echo "  OK — no TypeScript files staged."
fi

# ── 6. TypeScript check on staged files ──────────────────────────────────────
echo "Running TypeScript check..."
pnpm type-check 2>/dev/null
if [ $? -ne 0 ]; then
  echo ""
  echo "ERROR: TypeScript errors found. Run 'pnpm type-check' to see all errors."
  exit 1
fi
echo "  OK — TypeScript check passed."

# ── 7. Agent handoff reminder ────────────────────────────────────────────────
echo ""
echo "  REMINDER: Update .agent/HANDOFF.md with your session-close note."
echo "  Format: ## $(date +%Y-%m-%d) — [Agent Name] — CLOSE"
echo ""
echo "Pre-commit checks passed. Proceeding with commit."
echo ""
