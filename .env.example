# =============================================================================
# dobeu.net v3 — environment variables
# Copy to .env.local for local dev. Real values live in Vercel project settings.
# All values below are placeholders — never commit real secrets to this file.
# =============================================================================

# ---- Site ----
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time — never
# put secrets in them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Vercel Marketplace integration) ----
# The Vercel Marketplace Supabase integration auto-provisions the server-only
# VERCEL_SUPABASE_* vars. NEXT_PUBLIC_VERCEL_SUPABASE_URL/ANON_KEY are manually
# mirrored client-exposed copies (see lib/supabase/client.ts + middleware.ts).
NEXT_PUBLIC_VERCEL_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_VERCEL_SUPABASE_ANON_KEY=your-anon-key-here
VERCEL_SUPABASE_URL=https://your-project.supabase.co          # server-only
VERCEL_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here    # server-only — never expose to client

# ---- Admin gating ----
# Comma-separated list of emails that get /admin access.
# v1: jeremyw@dobeu.net only.
ADMIN_EMAILS=jeremyw@dobeu.net

# ---- Apollo (CRM + lead enrichment; not used for meetings) ----
APOLLO_API_KEY=your-apollo-key-here                 # server-only

# ---- Booking (Calendly free-tier) ----
# Existing Calendly account: jeremyw@dobeu.net → https://calendly.com/jeremyw-dobeu-r_el
# Set the full URL (root, or a specific event-type slug like "/30min").
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jeremyw-dobeu-r_el
# Server-side webhook → /api/webhooks/calendly turns a booking into a lead
# (Supabase + Apollo + Customer.io + Resend). Server-only.
# Signing key: returned when you create the webhook subscription via Calendly's API.
# Without it the webhook route is inert (returns 503) and never accepts unsigned calls.
CALENDLY_WEBHOOK_SIGNING_KEY=your-calendly-signing-key-here    # from POST https://api.calendly.com/webhook_subscriptions

# ---- Typeform ----
NEXT_PUBLIC_TYPEFORM_FORM_ID=your-typeform-id-here  # the qualified intake form id
# Server-side webhook → /api/typeform/webhook validates the Typeform signature.
# Without it the webhook route rejects all requests. Server-only.
TYPEFORM_WEBHOOK_SECRET=your-typeform-webhook-secret-here      # server-only

# ---- Analytics ----
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Mixpanel project token (public, safe to expose). Autocapture + 100% session
# recording are enabled in lib/analytics.ts. Override per env if you want to
# throttle recording in production.
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token-here
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXX
# GTM web container — provisioned at GTM-M97GN5T7 for www.dobeu.net.
# The noscript <iframe> fallback in app/layout.tsx reads this same env var.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX  # (prod: GTM-M97GN5T7)

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here          # server-only
# Used by /api/webhooks/stripe. Server-only.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here    # server-only

# ---- Email (Resend) ----
RESEND_API_KEY=re_your-resend-key-here              # server-only
RESEND_FROM_EMAIL=hello@dobeu.net
RESEND_REPLY_TO=jeremyw@dobeu.net

# ---- Datadog RUM + Logs (client-side observability) ----
# Create a "Browser" application in Datadog (UX Monitoring → Applications)
# then drop the IDs here. Server-side logs flow via the Datadog Vercel
# integration (Vercel Marketplace) — no extra code needed.
NEXT_PUBLIC_DATADOG_APPLICATION_ID=your-datadog-app-id-here
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your-datadog-client-token-here
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_SERVICE=dobeu-net
NEXT_PUBLIC_DATADOG_ENV=production
NEXT_PUBLIC_DATADOG_VERSION=

# ---- Intercom Messenger (in-app chat) ----
# Workspace App ID from Intercom → Settings → Installation → For Web
NEXT_PUBLIC_INTERCOM_APP_ID=your-intercom-app-id-here
# Intercom Secure Messenger JWT signing secret (server-only). Without it,
# createIntercomUserJwt() is a no-op and the Messenger boots unverified.
INTERCOM_API_SECRET=your-intercom-api-secret-here              # server-only
# Intercom Identity Verification HMAC secret (Settings → Security → Identity
# Verification). Separate from INTERCOM_API_SECRET above — this hashes the
# user_id sent from the portal/admin layouts. Server-only.
INTERCOM_IDENTITY_VERIFICATION_SECRET=your-intercom-identity-secret-here   # server-only

# ---- Customer.io (lifecycle, optional) ----
CUSTOMERIO_SITE_ID=your-customerio-site-id-here     # server-only
CUSTOMERIO_API_KEY=your-customerio-api-key-here     # server-only

# ---- Rate limiting (Upstash Redis REST API) ----
# Used by lib/rate-limit.ts to throttle /api/lead. Server-only.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here          # server-only

# ---- GitHub (read-only PAT for the /repos page + activity feed) ----
# Used by app/api/github-repo/route.ts and app/api/github-activity/route.ts
# to raise the unauthenticated GitHub API rate limit. Server-only.
GITHUB_TOKEN=ghp_your-github-token-here             # server-only

# ---- Embedded agent (Claude Agent SDK + Composio Tool Router) ----
# Powers lib/agent (used by app/api/agent/route.ts and scripts/agent.ts).
# Both are required — runAgent() no-ops with { ok: false, error: "not_configured" }
# if either is unset. Server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key-here       # server-only
COMPOSIO_API_KEY=your-composio-api-key-here         # server-only
# Optional: identifier used to scope the Composio session for the standalone
# scripts/agent.ts CLI worker. Defaults to "dobeu-ops" if unset. Server-only.
AGENT_USER_ID=dobeu-ops
